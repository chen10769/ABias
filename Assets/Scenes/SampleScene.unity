      value: "\u90AE\u4EF6"
      objectReference: {fileID: 0}
    - target: {fileID: 6771339419799536240, guid: 91e7c6ba6bfe5844f931d6c80692fe7d, type: 3}
      propertyPath: word
      value: "\u53D1\u4EF6\u4EBA\uFF1A\u9646\u660E\u8FDC\uFF08\u8463\u4E8B\u957F\uFF09\uFF1B\n\u6536\u4EF6\u4EBA\uFF1A\u738B\u6D69\uFF08\u5E02\u573A\u4E0E\u5546\u52A1\u90E8\u603B\u76D1\uFF09\u3001\u5218\u5CF0\uFF08\u6280\u672F\u90E8\u603B\u76D1\uFF09\uFF1B\n\u4E3B\u9898\uFF1A\u5173\u4E8E\u2018\u667A\u6167\u6C11\u751F\u4E91\u8BA1\u7B97\u670D\u52A1\u5E73\u53F0\u2019\u9879\u76EE\u63A8\u8FDB\u53CA\u5BF9\u5916\u5408\u4F5C\u4FDD\u5BC6\u5DE5\u4F5C\u7684\u901A\u77E5\uFF1B\n\u53D1\u9001\u65F6\u95F4\uFF1A2025\u5E743\u670825\u65E5\uFF1B\n\u6B63\u6587\uFF1A\n1.
        \u2018\u667A\u6167\u6C11\u751F\u4E91\u8BA1\u7B97\u670D\u52A1\u5E73\u53F0\u2019\u9879\u76EE\u5DF2\u987A\u5229\u83B7\u5F97\u5E02\u7EA7\u8865\u8D34800\u4E07\u5143\uFF0C\u9996\u671F\u8D44\u91D1\u8FD1\u671F\u5230\u8D26\uFF0C\u8BE5\u7B14\u8D44\u91D1\u4F18\u5148\u7528\u4E8E\u652F\u6491\u5BF9\u5916\u5408\u4F5C\u7684\u6570\u636E\u6574\u7406\u3001\u4F20\u8F93\u901A\u9053\u642D\u5EFA\u7B49\u76F8\u5173\u5DE5\u4F5C\uFF0C\u9879\u76EE\u8868\u9762\u8D44\u6599\u9700\u6309\u8981\u6C42\u5B8C\u5584\uFF0C\u5E94\u5BF9\u540E\u7EED\u76D1\u7BA1\u68C0\u67E5\u3002\n2.
        \u4E0E\u5883\u5916\u73AF\u7403\u6570\u636E\u54A8\u8BE2\u6709\u9650\u516C\u53F8\u7684\u5408\u4F5C\u534F\u8BAE\u521D\u7A3F\u5DF2\u5B8C\u6210\uFF0C\u540E\u7EED\u7531\u5E02\u573A\u90E8\u8DDF\u8FDB\u6CD5\u52A1\u5BA1\u6838\u53CA\u7B7E\u5B57\u6D41\u7A0B\uFF0C\u6838\u5FC3\u6570\u636E\u4F20\u8F93\u5DE5\u4F5C\u7531\u6280\u672F\u90E8\u8D1F\u8D23\uFF0C\u52A1\u5FC5\u642D\u5EFA\u72EC\u7ACB\u52A0\u5BC6\u4F20\u8F93\u901A\u9053\uFF0C\u505A\u597D\u6570\u636E\u4F20\u8F93\u75D5\u8FF9\u7684\u6E05\u7406\u5DE5\u4F5C\uFF0C\u907F\u514D\u88AB\u76D1\u7BA1\u90E8\u95E8\u5BDF\u89C9\u3002\n3.
        \u672C\u4EBA\u79C1\u4EBA\u529E\u516C\u533A\u529E\u516C\u7535\u8111\u7EDF\u4E00\u5BC6\u7801\uFF1ALMY2025\uFF0C\u540E\u7EED\u4E0E\u672C\u9879\u76EE\u76F8\u5173\u7684\u6240\u6709\u91CD\u8981\u6570\u636E\uFF0C\u9700\u540C\u6B65\u53CC\u91CD\u5907\u4EFD\u81F3\u6B64\u7535\u8111\u53CA\u52A0\u5BC6
        U \u76D8\uFF0C\u786E\u4FDD\u6570\u636E\u65E0\u6CC4\u9732\u3001\u65E0\u4E22\u5931\u3002"
