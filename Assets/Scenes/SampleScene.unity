      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 21300000, guid: f41bec5903485844694b5661424f7f15, type: 3}
    - target: {fileID: 5926422970065605132, guid: 91e7c6ba6bfe5844f931d6c80692fe7d, type: 3}
      propertyPath: m_Text
      value: "\u4EA4\u6613\u6E05\u5355"
      objectReference: {fileID: 0}
    - target: {fileID: 6771339419799536240, guid: 91e7c6ba6bfe5844f931d6c80692fe7d, type: 3}
      propertyPath: word
      value: "\u4E00\u3001\u6570\u636E\u4F20\u8F93\u89C4\u907F\u65B9\u6848\uFF1A\r\n1.
        \u91C7\u7528\u5883\u5916\u670D\u52A1\u5668\u4E2D\u8F6C\u4F20\u8F93\uFF0C\u6BCF\u5B63\u5EA6\u66F4\u6362\u4E00\u6B21\u4E2D\u8F6C\u8282\u70B9IP\uFF1B\r\n2.
        \u6570\u636E\u4F20\u8F93\u524D\u8FDB\u884C\u4E09\u5C42\u52A0\u5BC6\u5904\u7406\uFF0C\u4F2A\u88C5\u4E3A\u666E\u901A\u5546\u4E1A\u90AE\u4EF6\u9644\u4EF6\u53D1\u9001\uFF1B\r\n3.
