      propertyPath: word
      value: "\u4E00\u3001\u4EA4\u6613\u8BB0\u5F55\r\n2025\u5E744\u670810\u65E5\uFF0C\u6536\u5230\u5883\u5916\u73AF\u7403\u6570\u636E\u54A8\u8BE2\u6709\u9650\u516C\u53F8\u8F6C\u5165\u6BD4\u7279\u5E0115\u679A\uFF08\u6298\u5408\u4EBA\u6C11\u5E01\u7EA6680\u4E07\u5143\uFF09\uFF0C\u5907\u6CE8\u201C\u7B2C\u4E00\u6279\u6B21\u6570\u636E\u670D\u52A1\u8D39\u201D\uFF1B\r\n2025\u5E746\u670815\u65E5\uFF0C\u6536\u5230\u5883\u5916\u73AF\u7403\u6570\u636E\u54A8\u8BE2\u6709\u9650\u516C\u53F8\u8F6C\u5165\u6BD4\u7279\u5E0120\u679A\uFF08\u6298\u5408\u4EBA\u6C11\u5E01\u7EA6920\u4E07\u5143\uFF09\uFF0C\u5907\u6CE8\u201C\u7B2C\u4E8C\u6279\u6B21\u6570\u636E\u670D\u52A1\u8D39\u201D\uFF1B\r\n
        2025\u5E748\u670820\u65E5\uFF0C\u6536\u5230\u5883\u5916\u73AF\u7403\u6570\u636E\u54A8\u8BE2\u6709\u9650\u516C\u53F8\u8F6C\u5165\u6BD4\u7279\u5E0122\u679A\uFF08\u6298\u5408\u4EBA\u6C11\u5E01\u7EA61010\u4E07\u5143\uFF09\uFF0C\u5907\u6CE8\u201C\u7B2C\u4E09\u6279\u6B21\u6570\u636E\u670D\u52A1\u8D39\u201D\uFF1B\r\n\u8D44\u91D1\u6D41\u5411\uFF1A\u6240\u6709\u5230\u8D26\u6BD4\u7279\u5E01\u5747\u4E8E3\u4E2A\u5DE5\u4F5C\u65E5\u5185\u62C6\u5206\u8F6C\u51655\u4E2A\u533F\u540D\u6D77\u5916\u8D26\u6237\uFF0C\u5B8C\u6210\u8D44\u91D1\u6D17\u767D\u3002\r\n\r\n\u4E8C\u3001\u901A\u8BAF\u8BB0\u5F55\r\n2025\u5E744\u67088\u65E5\uFF08\u9646\u660E\u8FDC\u2192\u5883\u5916\u73AF\u7403\u6570\u636E\u54A8\u8BE2\u6709\u9650\u516C\u53F8\u8054\u7CFB\u4EBA\u201CK\u201D\uFF09\uFF1A\u201C\u7B2C\u4E00\u6279\u6B21\u6570\u636E\u5DF2\u6309\u7EA6\u5B9A\u4F20\u8F93\u5B8C\u6BD5\uFF0C\u542B\u9AD8\u7AEF\u5236\u9020\u4E1A\u6838\u5FC3\u6280\u672F\u53C2\u6570\u7EDF\u8BA1\u3001\u91CD\u70B9\u57CE\u5E02\u4EBA\u53E3\u6D41\u52A8\u6838\u5FC3\u6570\u636E\u5E93\uFF0C\u8BF7\u6CE8\u610F\u67E5\u6536\uFF0C\u540E\u7EED\u4ED8\u6B3E\u6309\u534F\u8BAE\u6267\u884C\u3002\u201D
