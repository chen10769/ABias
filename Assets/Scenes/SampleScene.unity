    - target: {fileID: 6771339419799536240, guid: 91e7c6ba6bfe5844f931d6c80692fe7d, type: 3}
      propertyPath: word
      value: "\u4E00\u4EFD\u4E0E\u5883\u5916\u7A7A\u58F3\u516C\u53F8\u7B7E\u8BA2\u7684\u534F\u8BAE\uFF0C\u5185\u5BB9\u4E3A\uFF1A\n\u7532\u65B9\uFF1A\u9F99\u817E\u5C16\u7AEF\u79D1\u6280\u96C6\u56E2\uFF1B\n\u4E59\u65B9\uFF1A\u5883\u5916\u73AF\u7403\u6570\u636E\u54A8\u8BE2\u6709\u9650\u516C\u53F8\uFF1B\n\u5408\u4F5C\u5B97\u65E8\uFF1A\u5F00\u5C55\u6570\u636E\u8D44\u6E90\u5171\u4EAB\u4E0E\u6280\u672F\u534F\u4F5C\uFF1B\n\u6838\u5FC3\u6761\u6B3E1\uFF1A\u7532\u65B9\u9700\u5728\u6BCF\u670815\u65E5\u524D\uFF0C\u5411\u4E59\u65B9\u79FB\u4EA4\u6307\u5B9A\u7C7B\u522B\u7684\u539F\u59CB\u6570\u636E\u8D44\u6E90\uFF0C\u6570\u636E\u8303\u56F4\u5305\u62EC\u4F46\u4E0D\u9650\u4E8E\u56FD\u5185\u884C\u4E1A\u6838\u5FC3\u7EDF\u8BA1\u6570\u636E\u3001\u91CD\u70B9\u9879\u76EE\u8FDB\u5C55\u6570\u636E\u7B49\uFF1B\n\u6838\u5FC3\u6761\u6B3E2\uFF1A\u4E59\u65B9\u6309\u5B63\u5EA6\u5411\u7532\u65B9\u652F\u4ED8\u5408\u4F5C\u8D39\u7528\uFF0C\u8D39\u7528\u4EE5\u7F8E\u5143\u7ED3\u7B97\uFF0C\u652F\u4ED8\u65B9\u5F0F\u53E6\u884C\u534F\u5546\uFF1B\n\u6838\u5FC3\u6761\u6B3E3\uFF1A\u53CC\u65B9\u9700\u5BF9\u5408\u4F5C\u5185\u5BB9\u4E25\u683C\u4FDD\u5BC6\uFF0C\u7532\u65B9\u9700\u91C7\u53D6\u52A0\u5BC6\u4F20\u8F93\u3001\u6570\u636E\u8131\u654F\uFF08\u8868\u9762\u6761\u6B3E\uFF0C\u5B9E\u9645\u672A\u660E\u786E\u8131\u654F\u6807\u51C6\uFF09\u7B49\u63AA\u65BD\u4FDD\u969C\u6570\u636E\u4F20\u8F93\u5B89\u5168\uFF1B\n\u9644\u5219\uFF1A\u672C\u534F\u8BAE\u81EA\u53CC\u65B9\u7B7E\u5B57\u76D6\u7AE0\u4E4B\u65E5\u8D77\u751F\u6548\uFF0C\u672A\u5C3D\u4E8B\u5B9C\u7531\u53CC\u65B9\u79C1\u4E0B\u534F\u5546\u89E3\u51B3\u3002"
      objectReference: {fileID: 0}
